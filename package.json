{
  "name": "rice-session-accounts",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:plugin": "claude plugin test .",
    "test:processes": "node scripts/proof-session-processes.mjs",
    "test:auth": "node scripts/proof-native-auth.mjs",
    "test:launcher": "node scripts/proof-native-launcher.mjs",
    "test:windows-launcher": "node scripts/proof-windows-native-launcher.mjs",
    "check": "npm test && npm run test:plugin && claude plugin validate --strict . && npm run test:processes && npm run test:auth && npm run test:launcher && git diff --check && git diff --cached --check"
  }
}
